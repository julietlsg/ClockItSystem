@model IEnumerable<ClockItSystem.Models.ClientStipendRate>

@{
    ViewData["Title"] = "Stipend Rates";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Stipend Rates</h2>
            <p class="text-muted mb-0">
                Manage daily stipend rates for each client.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Stipend Rate
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-cash-coin fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No stipend rates configured
                    </h5>

                    <p class="text-muted">
                        Add a stipend rate to begin configuring client payments.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Stipend Rate
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Client</th>
                                <th>Daily Rate</th>
                                <th>Effective From</th>
                                <th>Effective To</th>
                                <th>Status</th>
                                <th>Created By</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var rate in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @rate.Client?.Name
                                        </strong>
                                    </td>

                                    <td>
                                        <strong>
                                            R @rate.DailyRate.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @rate.EffectiveFrom.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(rate.EffectiveTo.HasValue
                                            ? rate.EffectiveTo.Value.ToString("dd MMM yyyy")
                                            : "Ongoing")
                                    </td>

                                    <td>
                                        @if (rate.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @rate.CreatedBy
                                    </td>

                                    <td>
                                        @rate.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-end">

                                        @if (rate.IsActive)
                                        {
                                            <form asp-action="Deactivate"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to deactivate this stipend rate?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@rate.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle"></i>
                                                    Deactivate
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>