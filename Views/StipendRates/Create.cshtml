@model ClockItSystem.Models.ViewModels.ClientStipendRateViewModel

@{
    ViewData["Title"] = "Add Stipend Rate";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="mb-1">Add Stipend Rate</h2>
            <p class="text-white mb-0">
            Configure the daily stipend amount for a client.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <!-- Client -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="ClientId"
                               class="form-label">
                            Client
                        </label>

                        <select asp-for="ClientId"
                                asp-items="Model.Clients"
                                class="form-select">

                            <option value="">
                                -- Select Client --
                            </option>

                        </select>

                        <span asp-validation-for="ClientId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Daily Rate -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="DailyRate"
                               class="form-label">
                            Daily Stipend Rate
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                R
                            </span>

                            <input asp-for="DailyRate"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   placeholder="150.00" />

                        </div>

                        <span asp-validation-for="DailyRate"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Effective From -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="EffectiveFrom"
                               class="form-label">
                            Effective From
                        </label>

                        <input asp-for="EffectiveFrom"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="EffectiveFrom"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Effective To -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="EffectiveTo"
                               class="form-label">
                            Effective To
                            <span class="text-muted">
                                (Optional)
                            </span>
                        </label>

                        <input asp-for="EffectiveTo"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="EffectiveTo"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Active -->
                    <div class="col-md-6 mb-3">

                        <div class="form-check">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active
                            </label>

                        </div>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save me-1"></i>

                        Save Stipend Rate

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}