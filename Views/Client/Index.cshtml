@using ClockItSystem.Models
@using ClockItSystem.Models.ViewModels

@model ListViewModel<Client>

@{
    ViewData["Title"] = "Client Management";

    var header = new AdminHeaderViewModel
    {
        Title = "Client Management",
        SubTitle = "Manage organisations and institutions",
        Icon = "bi bi-buildings",
        ButtonText = "Add Client",
        ButtonAction = "Create"
    };

    var searchFilter = new SearchFilterViewModel
    {
        Action = "Index",
        Filter = Model.Filter,
        ShowStatus = true
    };

    var pagination = new PaginationViewModel
    {
        Action = "Index",
        Pagination = Model.Pagination,
        RouteValues = new Dictionary<string, string?>
        {
            ["SearchTerm"] = Model.Filter.SearchTerm,
            ["IsActive"] = Model.Filter.IsActive?.ToString()
        }
    };
}

<div class="container-fluid mt-4">

    <partial name="_AdminHeader"
             model="header" />

    <div class="clockit-card shadow-sm">

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            <partial name="_SearchFilter"
                     model="searchFilter" />

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Client</th>

                            <th>Code</th>

                            <th>Contact Person</th>

                            <th>Email</th>

                            <th class="text-center">Sites</th>

                            <th>Status</th>

                            <th class="text-end" style="width:170px;">

                                Actions

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Items.Any())
                        {
                            @foreach (var client in Model.Items)
                            {
                                <tr>

                                    <td>

                                        <strong>@client.Name</strong>

                                    </td>

                                    <td>

                                        @client.Code

                                    </td>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(client.ContactPerson)
                                            ? "-"
                                            : client.ContactPerson)

                                    </td>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(client.Email)
                                            ? "-"
                                            : client.Email)

                                    </td>

                                    <td class="text-center">

                                        <span class="badge bg-primary">

                                            @(client.Sites?.Count ?? 0)

                                        </span>

                                    </td>

                                    <td>

                                        <partial name="_StatusBadge"
                                                 model="client.IsActive" />

                                    </td>

                                    <td class="text-end">

                                        <div class="action-buttons">

                                            <a asp-action="Details"
                                                   asp-route-id="@client.ClientId"
                                                   class="btn btn-sm btn-outline-info">
                                                View
                                            </a>

                                            <a asp-action="Edit"
                                                   asp-route-id="@client.ClientId"
                                                   class="btn btn-sm btn-outline-primary">
                                                Edit

                                            </a>

                                            <form asp-action="ToggleStatus"
                                                  asp-route-id="@client.ClientId"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                @if (client.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Are you sure you want to deactivate this client?');">
                                                        Deactivate

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            onclick="return confirm('Are you sure you want to activate this client?');">

                                                        <i class="bi bi-check-circle me-1"></i>

                                                        Activate

                                                    </button>
                                                }

                                            </form>

                                        </div>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7" class="text-center py-5">

                                    <i class="bi bi-buildings display-5 text-muted"></i>

                                    <h5 class="mt-3">

                                        No Clients Found

                                    </h5>

                                    <p class="text-muted">

                                        No clients matched your search criteria.

                                    </p>

                                    <a asp-action="Create"
                                           class="btn btn-primary">

                                        <i class="bi bi-plus-circle me-1"></i>

                                        Create First Client

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
            <div class="row mt-3">

                <div class="col-md-6 d-flex align-items-center">

                    <small class="text-muted">

                        Showing

                        <strong>

                            @Model.Pagination.StartRecord

                        </strong>

                        -

                        <strong>

                            @Model.Pagination.EndRecord

                        </strong>

                        of

                        <strong>

                            @Model.Pagination.TotalRecords

                        </strong>

                        client(s)

                    </small>

                </div>

                <div class="col-md-6">

                    <partial name="_Pagination"
                             model="pagination" />

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var tooltipTriggerList =
                [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));

            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl);
            });

        });
    </script>
}