@model List<ClockItSystem.Models.ViewModels.DailyApprovalViewModel>

@{
    ViewData["Title"] = "Daily Attendance Approval";

    var filter = Model.FirstOrDefault() ?? new ClockItSystem.Models.ViewModels.DailyApprovalViewModel();
}

<div class="container-fluid">

    <div class="clockit-card shadow-sm">
        <div class="d-flex justify-content-center gap-2">
            <div class="card-header">

                <h4 class="mb-0">

                    <i class="bi bi-check2-square"></i>


                </h4>
                Daily Attendance Approval

            </div>
        </div>
        <hr />

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">

                    @TempData["Success"]

                </div>
            }

            <form asp-action="Daily"
                  method="get"
                  id="filterForm">

                <div class="row g-3 align-items-end">

                    <!-- Client -->

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">

                            Client

                        </label>

                        <select class="form-select"
                                id="ClientId"
                                name="clientId">

                            <option value="">All Clients</option>

                            @foreach (var client in filter.Clients)
                            {
                                <option value="@client.Value"
                                        selected="@(filter.SelectedClientId?.ToString() == client.Value)">

                                    @client.Text

                                </option>
                            }

                        </select>

                    </div>

                    <!-- Site -->

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">

                            Site

                        </label>

                        <select class="form-select"
                                id="SiteId"
                                name="siteId">

                            <option value="">All Sites</option>

                            @foreach (var site in filter.Sites)
                            {
                                <option value="@site.Value"
                                        selected="@(filter.SelectedSiteId?.ToString() == site.Value)">

                                    @site.Text

                                </option>
                            }

                        </select>

                    </div>

                    <!-- Programme -->

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">

                            Programme

                        </label>

                        <select class="form-select"
                                name="programme">

                            <option value="">All Programmes</option>

                            @foreach (var programme in filter.Programmes)
                            {
                                <option value="@programme.Value"
                                        selected="@(filter.SelectedProgramme == programme.Value)">

                                    @programme.Text

                                </option>
                            }

                        </select>

                    </div>

                    <!-- Search -->

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">

                            Student

                        </label>

                        <input class="form-control"
                               name="searchTerm"
                               value="@filter.SearchTerm"
                               placeholder="Student No / Name" />

                    </div>

                    <!-- Date -->

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">

                            Date

                        </label>

                        <input class="form-control"
                               type="date"
                               name="date"
                               value="@filter.SelectedDate?.ToString("yyyy-MM-dd")" />

                    </div>

                    <!-- Buttons -->

                    <div class="col-md-2">

                        <div class="d-grid gap-2">

                            <button class="btn btn-clockit">

                                <i class="bi bi-search"></i>

                                Generate

                            </button>

                        </div>

                    </div>

                </div>

            </form>

            <hr />
            <table class="table table-hover table-striped align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>Student No</th>

                        <th>Student</th>

                        <th>Client</th>

                        <th>Site</th>

                        <th>Programme</th>

                        <th>Date</th>

                        <th>Time</th>

                        <th>Method</th>

                        <th>Score</th>

                        <th>Status</th>

                        <th style="width:120px">Face</th>

                        <th style="width:220px">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.StudentNumber</td>

                                <td>@item.StudentName</td>

                                <td>@item.ClientName</td>

                                <td>@item.SiteName</td>

                                <td>@item.ProgrammeOrCourse</td>

                                <td>@item.AttendanceDate.ToString("dd MMM yyyy")</td>

                                <td>@item.ClockTime.ToString("HH:mm")</td>

                                <td>

                                    @if (item.VerificationMethod == "Face")
                                    {
                                        <span class="badge bg-primary">

                                            <i class="bi bi-person-bounding-box"></i>

                                            Face

                                        </span>
                                    }
                                    else if (item.VerificationMethod == "Fingerprint")
                                    {
                                        <span class="badge bg-info text-dark">

                                            <i class="bi bi-fingerprint"></i>

                                            Fingerprint

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            Not Verified

                                        </span>
                                    }
                                </td>

                                <td>

                                    @(item.VerificationScore?.ToString("0.00") ?? "-")

                                </td>

                                <td>

                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">

                                            Approved

                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">

                                            Rejected

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">

                                            Pending

                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.CapturedImagePath))
                                    {
                                        <a href="@item.CapturedImagePath"
                                               target="_blank"
                                               class="btn btn-outline-info btn-sm">

                                            View

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            -

                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">

                                            Approved

                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">

                                            Rejected

                                        </span>
                                    }
                                    else if (item.Status == "Not Verified")
                                    {
                                        <button type="button"
                                                class="btn btn-warning btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rejectModal"
                                                data-student-id="@item.StudentId"
                                                data-attendance-date="@item.AttendanceDate.ToString("yyyy-MM-dd")"
                                                data-student="@item.StudentName">

                                            <i class="bi bi-person-x"></i>

                                            Mark Absent

                                        </button>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2">

                                            <form asp-action="Approve"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="studentId"
                                                       value="@item.StudentId" />

                                                <input type="hidden"
                                                       name="attendanceDate"
                                                       value="@item.AttendanceDate.ToString("yyyy-MM-dd")" />

                                                <button class="btn btn-success btn-sm">

                                                    <i class="bi bi-check-circle"></i>

                                                    Approve

                                                </button>

                                            </form>

                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#rejectModal"
                                                    data-student-id="@item.StudentId"
                                                    data-attendance-date="@item.AttendanceDate.ToString("yyyy-MM-dd")"
                                                    data-student="@item.StudentName">

                                                <i class="bi bi-x-circle"></i>

                                                Reject

                                            </button>

                                        </div>
                                    }

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="12"
                                class="text-center text-muted py-5">

                                No attendance records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
            <hr />

            <nav aria-label="Daily Attendance Pagination">

                <ul class="pagination justify-content-center">

                    @if (filter.CurrentPage > 1)
                    {
                        <li class="page-item">

                            <a class="page-link"
                                   asp-action="Daily"
                                   asp-route-page="@(filter.CurrentPage - 1)"
                                   asp-route-date="@filter.SelectedDate?.ToString("yyyy-MM-dd")"
                                   asp-route-clientId="@filter.SelectedClientId"
                                   asp-route-siteId="@filter.SelectedSiteId"
                                   asp-route-programme="@filter.SelectedProgramme"
                                   asp-route-searchTerm="@filter.SearchTerm">

                                Previous

                            </a>

                        </li>
                    }

                    @for (int i = 1; i <= filter.TotalPages; i++)
                    {
                        <li class="page-item @(i == filter.CurrentPage ? "active" : "")">

                            <a class="page-link"
                                   asp-action="Daily"
                                   asp-route-page="@i"
                                   asp-route-date="@filter.SelectedDate?.ToString("yyyy-MM-dd")"
                                   asp-route-clientId="@filter.SelectedClientId"
                                   asp-route-siteId="@filter.SelectedSiteId"
                                   asp-route-programme="@filter.SelectedProgramme"
                                   asp-route-searchTerm="@filter.SearchTerm">

                                @i

                            </a>

                        </li>
                    }

                    @if (filter.CurrentPage < filter.TotalPages)
                    {
                        <li class="page-item">

                            <a class="page-link"
                                   asp-action="Daily"
                                   asp-route-page="@(filter.CurrentPage + 1)"
                                   asp-route-date="@filter.SelectedDate?.ToString("yyyy-MM-dd")"
                                   asp-route-clientId="@filter.SelectedClientId"
                                   asp-route-siteId="@filter.SelectedSiteId"
                                   asp-route-programme="@filter.SelectedProgramme"
                                   asp-route-searchTerm="@filter.SearchTerm">

                                Next

                            </a>

                        </li>
                    }

                </ul>

            </nav>

        </div>

    </div>

</div>
<div class="modal fade"
     id="rejectModal"
     tabindex="-1"
     aria-labelledby="rejectModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="Reject"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="rejectModalLabel">

                        Student Attendance

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           id="studentId"
                           name="studentId" />

                    <input type="hidden"
                           id="attendanceDate"
                           name="attendanceDate" />

                    <div class="alert alert-info">

                        <strong>

                            Student:

                        </strong>

                        <span id="studentName"></span>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

                            Select Reason

                        </label>

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="radio"
                                   name="reason"
                                   id="Absent"
                                   value="StudentAbsent"
                                   checked />

                            <label class="form-check-label"
                                   for="Absent">

                                Student Absent

                            </label>

                        </div>

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="radio"
                                   name="reason"
                                   id="Leave"
                                   value="Leave" />

                            <label class="form-check-label"
                                   for="Leave">

                                Leave

                            </label>

                        </div>

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="radio"
                                   name="reason"
                                   id="SickLeave"
                                   value="SickLeave" />

                            <label class="form-check-label"
                                   for="SickLeave">

                                Sick Leave

                            </label>

                        </div>

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="radio"
                                   name="reason"
                                   id="FamilyResponsibilityLeave"
                                   value="FamilyResponsibilityLeave" />

                            <label class="form-check-label"
                                   for="FamilyResponsibilityLeave">

                                Family Responsibility Leave

                            </label>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

                            Comment

                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  name="comment"></textarea>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">

                            Supporting Document

                        </label>

                        <input type="file"
                               class="form-control"
                               name="supportingDocument" />

                        <small class="text-muted">

                            Optional

                        </small>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-clockit">

                        Save

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const rejectModal = document.getElementById("rejectModal");

            if (!rejectModal)
                return;

            rejectModal.addEventListener("show.bs.modal", function (event) {

                const button = event.relatedTarget;

                if (!button)
                    return;

                const studentId =
                    button.getAttribute("data-student-id");

                const attendanceDate =
                    button.getAttribute("data-attendance-date");

                const studentName =
                    button.getAttribute("data-student");

                document.getElementById("studentId").value =
                    studentId;

                document.getElementById("attendanceDate").value =
                    attendanceDate;

                document.getElementById("studentName").textContent =
                    studentName;

            });

        });

    </script>

    <script>

        $(function () {

            $("#SelectedClientId").change(function () {

                let clientId = $(this).val();

                $("#SelectedSiteId").empty();

                $("#SelectedSiteId").append(
                    $('<option>',
                    {
                        value: '',
                        text: '-- Loading Sites --'
                    }));

                $.get("/Students/GetSitesByClient",
                    {
                        clientId: clientId
                    },
                    function (data) {

                        $("#SelectedSiteId").empty();

                        $("#SelectedSiteId").append(
                            $('<option>',
                            {
                                value: '',
                                text: '-- All Sites --'
                            }));

                        $.each(data, function (i, site) {

                            $("#SelectedSiteId").append(

                                $('<option>',
                                {
                                    value: site.value,
                                    text: site.text
                                }));

                        });

                    });

            });

        });

    </script>

}