@using ClockItSystem.Models
@using ClockItSystem.Models.ViewModels

@model ListViewModel<Site>

@{
    var pagination = new PaginationViewModel
    {
        Action = "Index",

        Pagination = Model.Pagination,

        RouteValues = new Dictionary<string, string?>
        {
            ["SearchTerm"] = Model.Filter.SearchTerm,
            ["IsActive"] = Model.Filter.IsActive?.ToString()
        }
    };
}

<div class="table-responsive">

    <table class="table table-dark table-hover align-middle">

        <thead>

            <tr>

                <th>Site</th>

                <th>Code</th>

                <th>Client</th>

                <th>Address</th>

                <th class="text-center">Students</th>

                <th>Status</th>

                <th class="text-end">Actions</th>

            </tr>

        </thead>

        <tbody>

            @if (Model.Items.Any())
            {
                @foreach (var site in Model.Items)
                {
                    <tr>

                        <td>

                            <strong>@site.SiteName</strong>

                        </td>

                        <td>

                            @site.SiteCode

                        </td>

                        <td>

                            @site.Client.Name

                        </td>

                        <td>

                            @(string.IsNullOrWhiteSpace(site.Address)
                                ? "-"
                                : site.Address)

                        </td>

                        <td class="text-center">

                            <span class="badge bg-primary">

                                @(site.Students?.Count ?? 0)

                            </span>

                        </td>

                        <td>

                            <partial name="_StatusBadge"
                                     model="site.IsActive" />

                        </td>

                        <td class="text-end">

                            <div class="action-buttons">

                                <a asp-action="Details"
                                       asp-route-id="@site.SiteId"
                                       class="btn btn-sm btn-outline-secondary">

                                    <i class="bi bi-eye me-1"></i>

                                    View

                                </a>

                                <a asp-action="Edit"
                                       asp-route-id="@site.SiteId"
                                       class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-pencil-square me-1"></i>

                                    Edit

                                </a>

                                <form asp-action="ToggleStatus"
                                      asp-route-id="@site.SiteId"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    @if (site.IsActive)
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to deactivate this site?');">

                                            <i class="bi bi-slash-circle me-1"></i>

                                            Deactivate

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('Are you sure you want to activate this site?');">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Activate

                                        </button>
                                    }

                                </form>

                            </div>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="7" class="text-center py-5">

                        <i class="bi bi-geo-alt display-5 text-muted"></i>

                        <h5 class="mt-3">

                            No Sites Found

                        </h5>

                        <p class="text-muted">

                            No sites matched your search criteria.

                        </p>

                        <a asp-action="Create"
                               class="btn btn-clockit">
                            Create First Site

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<div class="row mt-3" >

    <div class="col-md-6 d-flex align-items-center">

        <small class="text-muted">

            Showing

            <strong>

                @Model.Pagination.StartRecord

            </strong>

            -

            <strong>

                @Model.Pagination.EndRecord

            </strong>

            of

            <strong>

                @Model.Pagination.TotalRecords

            </strong>

            site(s)

        </small>

    </div>

    <div class="col-md-6">

        <partial name="_Pagination"
                 model="pagination" />

    </div>

</div>