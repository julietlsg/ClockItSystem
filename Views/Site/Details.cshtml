@model ClockItSystem.Models.Site

@{
    ViewData["Title"] = "Site Details";
}

<div class="container-fluid mt-4">

    <div class="clockit-card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h4 class="mb-0">

                <i class="bi bi-info-circle-fill me-2"></i>

                Site Details

            </h4>

            <span>

                <partial name="_StatusBadge"
                         model="Model.IsActive" />

            </span>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">

                        Client

                    </label>

                    <div class="fw-semibold fs-5">

                        @Model.Client.Name

                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">

                        Site Name

                    </label>

                    <div class="fw-semibold fs-5">

                        @Model.SiteName

                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">

                        Site Code

                    </label>

                    <div>

                        @Model.SiteCode

                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">

                        Address

                    </label>

                    <div>

                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "-"
                            : Model.Address)

                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">

                        Students

                    </label>

                    <div>

                        <span class="badge bg-primary fs-6">

                            @(Model.Students?.Count ?? 0)

                        </span>

                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">

                        Created

                    </label>

                    <div>

                        @Model.CreatedDate.ToString("dd MMM yyyy HH:mm")

                    </div>

                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                       class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back

                </a>

                <a asp-action="Edit"
                       asp-route-id="@Model.SiteId"
                       class="btn btn-primary">

                    <i class="bi bi-pencil-square me-1"></i>

                    Edit

                </a>

            </div>

        </div>

    </div>

</div>