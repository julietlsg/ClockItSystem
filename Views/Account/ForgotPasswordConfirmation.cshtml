@{
    ViewData["Title"] = "Password Reset";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-body p-4 text-center">

                    <h2>Password Reset</h2>

                    <p class="text-muted mt-3">
                        If an account exists for the email address
                        provided, instructions to reset the password
                        have been generated.
                    </p>

                    @if (TempData["DevelopmentResetLink"] != null)
                    {
                        <div class="alert alert-warning text-start mt-4">

                            <strong>
                                Development Testing Only
                            </strong>

                            <p class="mb-2 mt-2">
                                Email is not configured yet.
                                Use the link below to test the
                                password reset process.
                            </p>

                            <a href="@TempData["DevelopmentResetLink"]"
                                   class="btn btn-warning w-100">
                                Test Password Reset
                            </a>

                        </div>
                    }

                    <div class="mt-3">
                        <a asp-action="Login">
                            Back to Login
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>