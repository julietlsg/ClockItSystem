@model ClockItSystem.Models.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "Add Student";
}

<div class="container mt-4">
    <h2>Add Student</h2>

    <div class="clockit-card">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <partial name="_StudentForm" model="Model" />

            <div class="mt-4">

                <button type="submit" class="btn btn-clockit">
                    Save Student
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const clientDropdown = document.getElementById("ClientId");
            const siteDropdown = document.getElementById("SiteId");

            const bankDropdown = document.getElementById("BankId");
            const branchDropdown = document.getElementById("BankBranchId");

            // ==========================
            // CLIENT -> SITE
            // ==========================

            async function loadSites(clientId, selectedSiteId = null) {

                siteDropdown.innerHTML = "";

                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.text = "-- Select Site --";

                siteDropdown.appendChild(defaultOption);

                if (!clientId)
                    return;

                try {

                    const response = await fetch(`/Students/GetSitesByClient?clientId=${clientId}`);

                    if (!response.ok)
                        throw new Error("Unable to load sites.");

                    const sites = await response.json();

                    sites.forEach(site => {

                        const option = document.createElement("option");

                        option.value = site.value;
                        option.text = site.text;

                        if (selectedSiteId && selectedSiteId == site.value)
                            option.selected = true;

                        siteDropdown.appendChild(option);

                    });

                }
                catch (err) {

                    console.error(err);

                }

            }

            // ==========================
            // BANK -> BRANCH
            // ==========================

            async function loadBranches(bankId, selectedBranchId = null) {

                branchDropdown.innerHTML = "";

                const defaultOption = document.createElement("option");

                defaultOption.value = "";
                defaultOption.text = "-- Select Branch --";

                branchDropdown.appendChild(defaultOption);

                if (!bankId)
                    return;

                try {

                    const response = await fetch(`/Students/GetBankBranches?bankId=${bankId}`);

                    if (!response.ok)
                        throw new Error("Unable to load branches.");

                    const branches = await response.json();

                    branches.forEach(branch => {

                        const option = document.createElement("option");

                        option.value = branch.value;
                        option.text = branch.text;

                        if (selectedBranchId && selectedBranchId == branch.value)
                            option.selected = true;

                        branchDropdown.appendChild(option);

                    });

                }
                catch (err) {

                    console.error(err);

                }

            }

            // ==========================
            // INITIAL LOAD
            // ==========================

            if (clientDropdown && clientDropdown.value) {

                loadSites(clientDropdown.value, siteDropdown.value);

            }

            if (bankDropdown && bankDropdown.value) {

                loadBranches(bankDropdown.value, branchDropdown.value);

            }

            // ==========================
            // EVENTS
            // ==========================

            if (clientDropdown) {

                clientDropdown.addEventListener("change", function () {

                    loadSites(this.value);

                });

            }

            if (bankDropdown) {

                bankDropdown.addEventListener("change", function () {

                    console.log("Selected Bank:", this.value);

                    loadBranches(this.value);

                });

            }

        });

    </script>
}