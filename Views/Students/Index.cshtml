@model ClockItSystem.Models.ViewModels.StudentSearchViewModel

@{
    ViewData["Title"] = "Students";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col-md-8">

            <h2 class="fw-bold text-primary mb-1">

                <i class="fas fa-user-graduate"></i>

                Students

            </h2>

            <p class="text-muted mb-0">

                Manage students, banking details and biometric enrolment.

            </p>

        </div>

        <div class="col-md-4 text-end">

            <a asp-action="Create"
               class="btn btn-primary">

                <i class="fas fa-plus"></i>

                Add Student

            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="fas fa-check-circle"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="fas fa-filter"></i>

                Search Filters

            </h5>

        </div>

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row">

                    <div class="col-md-4">

                        <label asp-for="SearchTerm"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="SearchTerm"
                               class="form-control"
                               placeholder="Student Number, Name, ID..." />

                    </div>

                    <div class="col-md-4">

                        <label asp-for="ClientId"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="ClientId"
                                asp-items="Model.Clients"
                                id="ClientId"
                                class="form-select">

                            <option value="">
                                All Clients
                            </option>

                        </select>

                    </div>

                    <div class="col-md-4">

                        <label asp-for="SiteId"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="SiteId"
                                asp-items="Model.Sites"
                                id="SiteId"
                                class="form-select">

                            <option value="">
                                All Sites
                            </option>

                        </select>

                    </div>

                </div>

                <div class="row mt-3">

                    <div class="col-md-4">

                        <label asp-for="ProgrammeOrCourse"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="ProgrammeOrCourse"
                                asp-items="Model.Programmes"
                                class="form-select">

                            <option value="">All Programmes</option>

                        </select>
                    </div>

                    <div class="col-md-4">

                        <label asp-for="IsActive"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="IsActive"
                                class="form-select">

                            <option value="">
                                All
                            </option>

                            <option value="true">
                                Active
                            </option>

                            <option value="false">
                                Inactive
                            </option>

                        </select>

                    </div>

                    <div class="col-md-4 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary me-2">

                            <i class="fas fa-search"></i>

                            Search

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="fas fa-undo"></i>

                            Clear

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-light">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="fas fa-list"></i>

                    Student Results

                </h5>

                <span class="badge bg-primary fs-6">

                    @Model.Students.Count()
                    @(Model.Students.Count() == 1 ? "Student" : "Students")

                </span>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">

                        <tr>

                            <th>Student No.</th>

                            <th>Student</th>

                            <th>Client</th>

                            <th>Site</th>

                            <th>Programme</th>

                            <th>Contact</th>

                            <th class="text-center">Status</th>

                            <th class="text-center" style="width:170px">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Students.Any())
                        {
                            @foreach (var student in Model.Students)
                            {
                                <tr>

                                    <td>

                                        <span class="fw-semibold">

                                            @student.StudentNumber

                                        </span>

                                    </td>

                                    <td>

                                        <div class="fw-semibold">

                                            @student.FirstName @student.LastName

                                        </div>

                                        <small class="text-muted">

                                            @student.IdNumber

                                        </small>

                                    </td>

                                    <td>

                                        @student.ClientName

                                    </td>

                                    <td>

                                        @student.SiteName

                                    </td>

                                    <td>

                                        @student.ProgrammeOrCourse

                                    </td>

                                    <td>

                                        @student.ContactNumber

                                    </td>

                                    <td class="text-center">

                                        @if (student.IsActive)
                                        {
                                            <span class="badge bg-success">

                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                Inactive

                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group"
                                             role="group">

                                        <div class="d-flex justify-content-center gap-1">

                                            <a asp-action="Details"
                                                   asp-route-id="@student.Id"
                                                   class="btn btn-outline-info btn-sm">

                                                <i class="fas fa-eye"></i>

                                                View

                                            </a>

                                            <a asp-action="Edit"
                                                   asp-route-id="@student.Id"
                                                   class="btn btn-outline-warning btn-sm">

                                                <i class="fas fa-edit"></i>

                                                Edit

                                            </a>

                                            <a asp-action="Delete"
                                                   asp-route-id="@student.Id"
                                                   class="btn btn-outline-danger btn-sm">

                                                <i class="fas fa-trash"></i>

                                                Delete

                                            </a>

                                        </div>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5">

                                    <i class="fas fa-user-slash fa-3x text-muted mb-3"></i>

                                    <h5>

                                        No students found

                                    </h5>

                                    <p class="text-muted mb-0">

                                        Try changing your search criteria or add a new student.

                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        $(function () {

            // Submit search when pressing ENTER
            $("input").keypress(function (e) {

                if (e.which === 13) {

                    $(this).closest("form").submit();

                }

            });

            // Clear Site when Client changes
            $("#ClientId").change(function () {

                $("#SiteId").val("");

            });

        });

    </script>
}
