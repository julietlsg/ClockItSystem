@model ClockItSystem.Models.ViewModels.StudentBulkUploadPreviewViewModel

@{
    ViewData["Title"] = "Student Bulk Upload - Confirm Import";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Student Bulk Upload</h2>
            <p class="text-white mb-0">Confirm Import</p>
        </div>

        <a asp-action="BulkUpload" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Cancel
        </a>
    </div>


    <!-- Validation Status -->
    @if (Model.InvalidRows == 0 && Model.ValidRows > 0)
    {
        <div class="alert alert-success">
            <strong>
                <i class="bi bi-check-circle-fill"></i>
                Validation successful.
            </strong>

            @Model.ValidRows student record@(Model.ValidRows == 1 ? "" : "s")
            are ready to be imported.
        </div>
    }
    else if (Model.InvalidRows > 0)
    {
        <div class="alert alert-danger">
            <strong>
                <i class="bi bi-exclamation-triangle-fill"></i>
                Validation failed.
            </strong>

            @Model.InvalidRows record@(Model.InvalidRows == 1 ? "" : "s")
            contain@(Model.InvalidRows == 1 ? "s" : "") validation error@(Model.InvalidRows == 1 ? "" : "s").

            Please correct the Excel file and upload it again.
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <strong>
                <i class="bi bi-exclamation-circle-fill"></i>
                No student records found.
            </strong>

            The uploaded file does not contain any student records to import.
        </div>
    }


    <!-- Import Summary -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Import Summary</strong>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="small text-muted">
                        File
                    </div>

                    <div class="fw-semibold">
                        @Model.OriginalFileName
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="small text-muted">
                        Records
                    </div>

                    <div class="fs-5 fw-semibold">
                        @Model.TotalRows
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="small text-muted">
                        Valid
                    </div>

                    <div class="fs-5 fw-semibold text-success">
                        @Model.ValidRows
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="small text-muted">
                        Errors
                    </div>

                    <div class="fs-5 fw-semibold @(Model.InvalidRows > 0 ? "text-danger" : "text-success")">
                        @Model.InvalidRows
                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- ========================================================= -->
    <!-- VALID STUDENTS -->
    <!-- ========================================================= -->
    @if (Model.ValidRows > 0)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>
                    <i class="bi bi-check-circle text-success"></i>
                    Students Ready for Import
                </strong>

                <span class="badge bg-success">
                    @Model.ValidRows Valid
                </span>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover table-sm align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Row</th>
                                <th>Student Number</th>
                                <th>ID Number</th>
                                <th>Student</th>
                                <th>Client</th>
                                <th>Site</th>
                                <th>Programme</th>
                                <th>Active</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var row in Model.Rows.Where(r => r.IsValid))
                            {
                                <tr>

                                    <td>
                                        @row.RowNumber
                                    </td>

                                    <td>
                                        @row.StudentNumber
                                    </td>

                                    <td>
                                        @row.IdNumber
                                    </td>

                                    <td>
                                        @row.FirstName @row.LastName
                                    </td>

                                    <td>
                                        @row.ClientName
                                    </td>

                                    <td>
                                        @row.SiteName
                                    </td>

                                    <td>
                                        @row.ProgrammeOrCourse
                                    </td>

                                    <td>
                                        @if (row.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                TRUE
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                FALSE
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>
                    Students Ready for Import
                </strong>
            </div>

            <div class="card-body">

                <div class="alert alert-light border mb-0">
                    <i class="bi bi-info-circle"></i>
                    There are no valid student records available for import.
                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- VALIDATION ERRORS -->
    <!-- ========================================================= -->
    @if (Model.InvalidRows > 0)
    {
        <div class="card shadow-sm mb-4 border-danger">

            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">

                <strong>
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Validation Errors
                </strong>

                <span class="badge bg-light text-danger">
                    @Model.InvalidRows Error@(Model.InvalidRows == 1 ? "" : "s")
                </span>

            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover table-sm align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th style="width: 70px;">Row</th>
                                <th style="width: 180px;">Student Number</th>
                                <th style="width: 180px;">ID Number</th>
                                <th>Student</th>
                                <th style="width: 260px;">Validation Error</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var row in Model.Rows.Where(r => !r.IsValid))
                            {
                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            @row.RowNumber
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.StudentNumber))
                                        {
                                            @row.StudentNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not supplied
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.IdNumber))
                                        {
                                            @row.IdNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not supplied
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.FirstName) ||
                                            !string.IsNullOrWhiteSpace(row.LastName))
                                        {
                                            @row.FirstName @row.LastName
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Name not supplied
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        @if (row.Errors != null && row.Errors.Count > 0)
                                        {
                                            <ul class="mb-0 ps-3 text-danger">

                                                @foreach (var error in row.Errors)
                                                {
                                                    <li>
                                                        @error
                                                    </li>
                                                }

                                            </ul>
                                        }
                                        else
                                        {
                                            <span class="text-danger">
                                                Validation failed.
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>


        <!-- Error Instructions -->
        <div class="alert alert-warning">

            <strong>
                <i class="bi bi-info-circle-fill"></i>
                Action required
            </strong>

            <p class="mb-0 mt-1">
                The upload cannot continue while validation errors exist.
                Correct the affected rows in the Excel file and upload the
                file again.
            </p>

        </div>
    }


    <!-- ========================================================= -->
    <!-- IMPORT CONFIRMATION -->
    <!-- ========================================================= -->
    @if (Model.CanImport)
    {
        <div class="alert alert-warning">

            <strong>
                <i class="bi bi-exclamation-circle-fill"></i>
                Please confirm before continuing.
            </strong>

            <div class="mt-1">
                Clicking <strong>Import Students</strong> will create these
                student records in ClockIT.

                Existing students will not be overwritten.

                Face and fingerprint information is not imported from the
                Excel file.
            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- ACTION BUTTONS -->
    <!-- ========================================================= -->

    <form asp-action="ImportBulkUpload"
          method="post"
          onsubmit="return confirm('Are you sure you want to import these students into ClockIT?');">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="token"
               value="@Model.FileToken" />


        <div class="d-flex justify-content-between">

            <!-- Always allow the user to upload a corrected file -->
            <a asp-action="BulkUpload"
               class="btn btn-outline-secondary">

                <i class="bi bi-upload"></i>
                Upload Different File

            </a>


            <!-- Import is ONLY available when every row is valid -->
            @if (Model.CanImport)
            {
                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-database-add"></i>

                    Import
                    @Model.ValidRows
                    Student@(Model.ValidRows == 1 ? "" : "s")

                </button>
            }

        </div>

    </form>

</div>