@model ClockItSystem.Models.ViewModels.StudentBulkUploadImportResultViewModel

@{
    ViewData["Title"] = "Student Bulk Upload - Import Complete";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <div class="display-4 text-success mb-3">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <h2 class="mb-2">Import Successful</h2>

            <p class="text-muted mb-4">
                The student records have been successfully added to ClockIT.
            </p>

            <div class="row justify-content-center mb-4">
                <div class="col-md-4">
                    <div class="card bg-light border-0">
                        <div class="card-body">
                            <div class="small text-muted">Students Imported</div>
                            <div class="display-6 fw-semibold text-success">
                                @Model.ImportedCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <p class="small text-muted">
                File: <strong>@Model.FileName</strong>
            </p>

            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-action="Index" class="btn btn-primary">
                    View Students
                </a>
                <a asp-action="BulkUpload" class="btn btn-outline-secondary">
                    Upload More Students
                </a>
            </div>
        </div>
    </div>
</div>
