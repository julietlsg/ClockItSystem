@model ClockItSystem.Models.ViewModels.StudentViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row">

    <div class="col-md-6 mb-3">

        <label asp-for="ClientId" class="form-label fw-semibold"></label>

        <select asp-for="ClientId"
                asp-items="Model.Clients"
                class="form-select"
                id="ClientId">

            <option value="">-- Select Client --</option>

        </select>

        <span asp-validation-for="ClientId" class="text-danger"></span>

    </div>

    <div class="col-md-6 mb-3">

        <label asp-for="SiteId" class="form-label fw-semibold"></label>

        <select asp-for="SiteId"
                asp-items="Model.Sites"
                class="form-select"
                id="SiteId">

            <option value="">-- Select Site --</option>

        </select>

        <span asp-validation-for="SiteId" class="text-danger"></span>

    </div>

</div>

<div class="row">

    <div class="col-md-6 mb-3">

        <label asp-for="StudentNumber" class="form-label fw-semibold"></label>

        <input asp-for="StudentNumber" class="form-control" />

        <span asp-validation-for="StudentNumber" class="text-danger"></span>

    </div>

    <div class="col-md-6 mb-3">

        <label asp-for="IdNumber" class="form-label fw-semibold"></label>

        <input asp-for="IdNumber" class="form-control" />

        <span asp-validation-for="IdNumber" class="text-danger"></span>

    </div>

</div>

<div class="row">

    <div class="col-md-6 mb-3">

        <label asp-for="FirstName" class="form-label fw-semibold"></label>

        <input asp-for="FirstName" class="form-control" />

        <span asp-validation-for="FirstName" class="text-danger"></span>

    </div>

    <div class="col-md-6 mb-3">

        <label asp-for="LastName" class="form-label fw-semibold"></label>

        <input asp-for="LastName" class="form-control" />

        <span asp-validation-for="LastName" class="text-danger"></span>

    </div>

</div>

<div class="row">

    <div class="col-md-6 mb-3">

        <label asp-for="ProgrammeOrCourse" class="form-label fw-semibold"></label>

        <input asp-for="ProgrammeOrCourse" class="form-control" />

        <span asp-validation-for="ProgrammeOrCourse" class="text-danger"></span>

    </div>

    <div class="col-md-6 mb-3">

        <label asp-for="ContactNumber" class="form-label fw-semibold"></label>

        <input asp-for="ContactNumber" class="form-control" />

        <span asp-validation-for="ContactNumber" class="text-danger"></span>

    </div>

</div>


@if (Model.CanEditBankingDetails)
{
    <!-- Banking Details Card -->
    <div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fas fa-university"></i>
            Banking Details
        </h5>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6 mb-3">
                <label asp-for="BankId" class="form-label"></label>

                <select asp-for="BankId"
                        asp-items="Model.Banks"
                        class="form-select"
                        id="BankId">
                    <option value="">-- Select Bank --</option>
                </select>

                <span asp-validation-for="BankId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="BankBranchId" class="form-label"></label>

                <select asp-for="BankBranchId"
                        asp-items="Model.BankBranches"
                        class="form-select"
                        id="BankBranchId">
                    <option value="">-- Select Branch --</option>
                </select>

                <span asp-validation-for="BankBranchId" class="text-danger"></span>
            </div>

        </div>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label asp-for="AccountTypeId" class="form-label"></label>

                <select asp-for="AccountTypeId"
                        asp-items="Model.AccountTypes"
                        class="form-select">

                    <option value="">-- Select Account Type --</option>

                </select>

                <span asp-validation-for="AccountTypeId"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="AccountHolderName"
                       class="form-label"></label>

                <input asp-for="AccountHolderName"
                       class="form-control" />

                <span asp-validation-for="AccountHolderName"
                      class="text-danger"></span>

            </div>

        </div>

        <div class="row">

            <div class="col-md-6">

                <label asp-for="AccountNumber"
                       class="form-label"></label>

                <input asp-for="AccountNumber"
                       class="form-control" />

                <span asp-validation-for="AccountNumber"
                      class="text-danger"></span>

            </div>

        </div>

    </div>
</div>

}
else
{
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">
                <i class="fas fa-lock"></i>
                Banking Details
            </h5>
        </div>

        <div class="card-body">

            <div class="alert alert-info mb-0">
                You do not have permission to edit banking details.
            </div>

        </div>
    </div>
}


<div class="mb-3">

    <label asp-for="FaceImage" class="form-label fw-semibold"></label>

    <input asp-for="FaceImage"
           type="file"
           class="form-control"
           accept=".jpg,.jpeg,.png" />

    <span asp-validation-for="FaceImage" class="text-danger"></span>

</div>

@if (!string.IsNullOrWhiteSpace(Model.ExistingFaceImagePath))
{
    <div class="mb-3">

        <label class="form-label fw-semibold">
            Current Face Image
        </label>

        <div>

            <img src="@Model.ExistingFaceImagePath"
                 class="img-thumbnail"
                 style="max-width:200px;" />

        </div>

    </div>
}

<div class="form-check mb-4">

    <input asp-for="IsActive" class="form-check-input" />

    <label asp-for="IsActive" class="form-check-label"></label>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            // ----------------------------
            // Client -> Site
            // ----------------------------
            $("#ClientId").change(function () {

                var clientId = $(this).val();

                var siteDropdown = $("#SiteId");

                siteDropdown.empty();

                siteDropdown.append(
                    $("<option>")
                        .val("")
                        .text("-- Select Site --")
                );

                if (!clientId)
                    return;

                $.get("/Students/GetSitesByClient",
                    { clientId: clientId },
                    function (data) {

                        $.each(data, function (i, site) {

                            siteDropdown.append(

                                $("<option>")
                                    .val(site.value)
                                    .text(site.text)

                            );

                        });

                    });

            });

            // ----------------------------
            // Bank -> Branch
            // ----------------------------
            $("#BankId").change(function () {

                var bankId = $(this).val();

                var branchDropdown = $("#BankBranchId");

                branchDropdown.empty();

                branchDropdown.append(
                    $("<option>")
                        .val("")
                        .text("-- Select Branch --")
                );

                if (!bankId)
                    return;

                $.get("/Students/GetBankBranches",
                    { bankId: bankId },
                    function (data) {

                        $.each(data, function (i, branch) {

                            branchDropdown.append(

                                $("<option>")
                                    .val(branch.value)
                                    .text(branch.text)

                            );

                        });

                    });

            });


    </script>
}