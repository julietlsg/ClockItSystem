@model ClockItSystem.ViewModels.NetcashBatchPreviewViewModel

@{
    ViewData["Title"] = "Netcash Batch Preview";
    var zar = new System.Globalization.CultureInfo("en-ZA");

    var invalidPayments = Model.Payments.Count(x => !x.BankingDetailsValid);
    var batchReady = invalidPayments == 0;

    var netcashFileToken = ViewBag.NetcashFileToken as string;
    var netcashUploadStatus = ViewBag.NetcashUploadStatus as string;
    var netcashUploadReport = ViewBag.NetcashUploadReport as string;

    DateTime? submittedAt = null;
    if (ViewBag.SubmittedAt is DateTime dateTime)
    {
        submittedAt = dateTime;
    }

    var hasNetcashResponse = !string.IsNullOrWhiteSpace(netcashUploadStatus);
    var netcashSubmissionSuccessful = string.Equals(netcashUploadStatus, "Successful", StringComparison.OrdinalIgnoreCase);
    var netcashSubmissionFailed = string.Equals(netcashUploadStatus, "Unsuccessful", StringComparison.OrdinalIgnoreCase);
    var netcashSuccessfulWithErrors = string.Equals(netcashUploadStatus, "SuccessfulWithErrors", StringComparison.OrdinalIgnoreCase);
    var alreadySubmitted = netcashSubmissionSuccessful;
}


<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>

            <div class="d-flex align-items-center gap-2">

                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white"
                      style="width:42px;height:42px;">

                    <i class="bi bi-bank fs-5"></i>

                </span>

                <div>

                    <h2 class="mb-0 text-white fw-bold">
                        Netcash Batch Preview
                    </h2>

                    <div class="text-white fw-semibold">
                        @Model.ClientName
                        <span class="mx-2 opacity-75">•</span>
                        @Model.PeriodFrom.ToString("MMMM yyyy")
                    </div>

                    <div class="mt-2">

                        <span class="badge bg-primary">

                            <i class="bi bi-calendar-event me-1"></i>

                            Payment Date:
                            @Model.PaymentDate.ToString("dd MMMM yyyy")

                        </span>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Details"
               asp-route-id="@Model.PaymentRunId"
               class="btn btn-primary">

                <i class="bi bi-arrow-left me-1"></i>
                Payment Run

            </a>

        </div>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <div class="d-flex gap-2 align-items-start">

                <i class="bi bi-check-circle-fill fs-5"></i>

                <div>
                    <strong>Success</strong>

                    <div class="mt-1">
                        @TempData["Success"]
                    </div>
                </div>

            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <div class="d-flex gap-2 align-items-start">

                <i class="bi bi-exclamation-circle-fill fs-5"></i>

                <div>
                    <strong>Netcash Submission Error</strong>

                    <div class="mt-1">
                        @TempData["Error"]
                    </div>
                </div>

            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- IMPORTANT NOTICE -->
    <div class="alert alert-warning shadow-sm">

        <div class="d-flex gap-2">

            <i class="bi bi-exclamation-triangle-fill fs-5"></i>

            <div>

                <strong>Netcash Batch Preview</strong>

                <div class="mt-1">

                    @if (netcashSubmissionSuccessful)
                    {
                        <span>This payment batch was successfully submitted to Netcash. A duplicate submission is not permitted.</span>
                    }
                    else if (netcashSubmissionFailed)
                    {
                        <span>The previous Netcash submission was unsuccessful. Review the Netcash report, correct the issue, and retry.</span>
                    }
                    else if (netcashSuccessfulWithErrors)
                    {
                        <span>Netcash loaded the batch but reported errors. Review the Netcash upload report before proceeding.</span>
                    }
                    else
                    {
                        <span>This page shows the payment information that will be used to prepare the Netcash payment batch. No payment has been successfully submitted to Netcash at this stage.</span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- NETCASH SUBMISSION STATUS -->
    @if (hasNetcashResponse)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                @if (netcashSubmissionSuccessful)
                {
                    <div class="d-flex align-items-start gap-3">
                        <div class="text-success fs-2"><i class="bi bi-cloud-check-fill"></i></div>
                        <div class="flex-grow-1">
                            <div class="fw-bold text-success">Netcash Upload Successful</div>
                            <div class="text-muted mt-1">Netcash confirmed that the payment batch was successfully loaded. A duplicate submission is not permitted.</div>
                        </div>
                    </div>
                }
                else if (netcashSubmissionFailed)
                {
                    <div class="d-flex align-items-start gap-3">
                        <div class="text-danger fs-2"><i class="bi bi-x-circle-fill"></i></div>
                        <div class="flex-grow-1">
                            <div class="fw-bold text-danger">Netcash Upload Unsuccessful</div>
                            <div class="text-muted mt-1">Netcash received the batch but the upload report indicates that it was unsuccessful. Correct the reported issue and retry the submission.</div>
                        </div>
                    </div>
                }
                else if (netcashSuccessfulWithErrors)
                {
                    <div class="d-flex align-items-start gap-3">
                        <div class="text-warning fs-2"><i class="bi bi-exclamation-triangle-fill"></i></div>
                        <div class="flex-grow-1">
                            <div class="fw-bold text-warning">Netcash Upload Successful With Errors</div>
                            <div class="text-muted mt-1">Netcash loaded the batch but reported errors in the upload report. Review the report before taking further action.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-start gap-3">
                        <div class="text-secondary fs-2"><i class="bi bi-question-circle-fill"></i></div>
                        <div class="flex-grow-1">
                            <div class="fw-bold text-secondary">Netcash Upload Status Unknown</div>
                            <div class="text-muted mt-1">ClockIT received a response from Netcash, but could not determine the final upload status. Review the report before retrying.</div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(netcashFileToken))
                {
                    <div class="mt-4">
                        <div class="small text-muted fw-semibold">Netcash File Token</div>
                        <div class="mt-1"><code class="bg-light border rounded px-2 py-1">@netcashFileToken</code></div>
                    </div>
                }

                @if (submittedAt.HasValue)
                {
                    <div class="mt-2">
                        <small class="text-muted"><i class="bi bi-clock me-1"></i>Submitted: @submittedAt.Value.ToString("dd MMMM yyyy HH:mm")</small>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(netcashUploadReport))
                {
                    <div class="mt-4">
                        <div class="small text-muted fw-semibold mb-2">Netcash Upload Report</div>
                        <div class="bg-light border rounded p-3">
                            <pre class="mb-0 small" style="white-space: pre-wrap; word-break: break-word;">@netcashUploadReport</pre>
                        </div>
                    </div>
                }
            </div>
        </div>
    }


    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted small fw-semibold text-uppercase">
                        Payment Run
                    </div>

                    <div class="fs-5 fw-bold mt-1">
                        #@Model.PaymentRunId
                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted small fw-semibold text-uppercase">
                        Payments
                    </div>

                    <div class="fs-4 fw-bold mt-1">
                        @Model.TotalPayments
                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted small fw-semibold text-uppercase">
                        Batch Total
                    </div>

                    <div class="fs-4 fw-bold text-success mt-1">
                        @Model.TotalAmount.ToString("C2", zar)
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- VALIDATION STATUS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            @if (netcashSubmissionSuccessful)
            {
                <div class="d-flex align-items-center gap-3">

                    <div class="text-success fs-3">

                        <i class="bi bi-check-circle-fill"></i>

                    </div>

                    <div>

                        <div class="fw-bold text-success">
                            Batch Submitted Successfully
                        </div>

                        <div class="text-muted">
                            Netcash confirmed that the batch was successfully loaded and it cannot be submitted again.
                        </div>

                    </div>

                </div>
            }
            else if (netcashSubmissionFailed)
            {
                <div class="d-flex align-items-center gap-3">
                    <div class="text-danger fs-3"><i class="bi bi-x-circle-fill"></i></div>
                    <div>
                        <div class="fw-bold text-danger">Previous Netcash Submission Failed</div>
                        <div class="text-muted">Review the Netcash upload report, correct the issue, and retry the submission.</div>
                    </div>
                </div>
            }
            else if (netcashSuccessfulWithErrors)
            {
                <div class="d-flex align-items-center gap-3">
                    <div class="text-warning fs-3"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <div>
                        <div class="fw-bold text-warning">Batch Loaded With Errors</div>
                        <div class="text-muted">Netcash loaded the batch but reported errors. Review the upload report before proceeding.</div>
                    </div>
                </div>
            }
            else if (batchReady)
            {
                <div class="d-flex align-items-center gap-3">

                    <div class="text-success fs-3">

                        <i class="bi bi-check-circle-fill"></i>

                    </div>

                    <div>

                        <div class="fw-bold">
                            Batch Ready
                        </div>

                        <div class="text-muted">
                            All payment records contain the required banking information.
                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-3">

                    <div class="text-danger fs-3">

                        <i class="bi bi-exclamation-circle-fill"></i>

                    </div>

                    <div>

                        <div class="fw-bold text-danger">
                            Batch Cannot Be Generated
                        </div>

                        <div class="text-muted">
                            @invalidPayments payment(s) have incomplete banking information.
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- PAYMENT TABLE -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <div>

                <h5 class="mb-0 fw-bold">

                    <i class="bi bi-list-check me-2 text-primary"></i>

                    Netcash Payment Instructions

                </h5>

                <small class="text-muted">
                    Review each payment before submitting the batch.
                </small>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-3">
                                Student
                            </th>

                            <th>
                                Account Holder
                            </th>

                            <th>
                                Bank
                            </th>

                            <th>
                                Branch Code
                            </th>

                            <th>
                                Account Number
                            </th>

                            <th>
                                Account Type
                            </th>

                            <th>
                                Payment Reference
                            </th>

                            <th class="text-end pe-3">
                                Amount
                            </th>

                            <th class="text-center">
                                Validation
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var payment in Model.Payments)
                        {
                            <tr>

                                <td class="ps-3">

                                    <div class="fw-bold">
                                        @payment.StudentName
                                    </div>

                                    <small class="text-muted">
                                        @payment.StudentNumber
                                    </small>

                                </td>


                                <td>
                                    @payment.AccountHolderName
                                </td>


                                <td>
                                    @payment.BankName
                                </td>


                                <td>
                                    @payment.BranchCode
                                </td>


                                <td>
                                    @payment.AccountNumber
                                </td>


                                <td>
                                    @payment.AccountType
                                </td>


                                <td>

                                    <small class="font-monospace">
                                        @payment.PaymentReference
                                    </small>

                                </td>


                                <td class="text-end pe-3">

                                    <strong class="text-success">
                                        @payment.Amount.ToString("C2", zar)
                                    </strong>

                                </td>


                                <td class="text-center">

                                    @if (payment.BankingDetailsValid)
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Valid

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"
                                              title="@payment.ValidationMessage">

                                            <i class="bi bi-exclamation-circle me-1"></i>

                                            Invalid

                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- ACTIONS -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                <div>

                    <h6 class="mb-1 fw-bold">

                        <i class="bi bi-shield-check me-2"></i>

                        Batch Actions

                    </h6>

                    <small class="text-muted">

                        @if (netcashSubmissionSuccessful)
                        {
                            <span>
                                This batch has already been submitted to Netcash.
                            </span>
                        }
                        else
                        {
                            <span>
                                Review the payment information carefully before submitting the batch to Netcash.
                            </span>
                        }

                    </small>

                </div>


                <div class="d-flex flex-wrap gap-2">

                    <a asp-action="Details"
                       asp-route-id="@Model.PaymentRunId"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>

                        Back to Payment Run

                    </a>


                    @if (batchReady)
                    {
                        <a asp-action="DownloadNetcashBatch"
                           asp-route-id="@Model.PaymentRunId"
                           class="btn btn-success">

                            <i class="bi bi-download me-1"></i>

                            Download Netcash .txt

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-secondary"
                                disabled>

                            <i class="bi bi-lock me-1"></i>

                            Batch Not Ready

                        </button>
                    }


                    @if (batchReady && !netcashSubmissionSuccessful)
                    {
                        <form asp-action="SubmitNetcashBatch"
                              asp-route-id="@Model.PaymentRunId"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirmNetcashSubmission();">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-cloud-arrow-up me-1"></i>
                                @(netcashSubmissionFailed ? "Retry Netcash Submission" : "Submit to Netcash")
                            </button>

                        </form>
                    }
                    else if (netcashSubmissionSuccessful)
                    {
                        <button type="button" class="btn btn-success" disabled>
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Submitted Successfully
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary" disabled>
                            <i class="bi bi-lock me-1"></i>
                            Submit Unavailable
                        </button>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        function confirmNetcashSubmission() {

            return confirm(
                "You are about to submit this payment batch to Netcash.\n\n" +
                "Please make sure that:\n" +
                "• All banking details have been verified.\n" +
                "• The payment date is correct.\n" +
                "• The payment amounts are correct.\n" +
                "• The batch is approved.\n\n" +
                "If Netcash reports the batch as unsuccessful, you may correct the issue and retry.\n\n" +
                "Do you want to continue?"
            );

        }

    </script>
}