@model IEnumerable<ClockItSystem.Models.StipendPaymentRun>

@{
    ViewData["Title"] = "Payment Runs";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-cash-stack me-2"></i>
                Payment Runs
            </h2>

            <p class="mb-1 text-white">
                View and manage monthly stipend payment runs.
            </p>
        </div>

        <a asp-controller="PaymentRuns"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>
            Create Payment Run

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-cash-stack fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No Payment Runs
                    </h5>

                    <p class="text-muted">
                        No payment runs have been created yet.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Create Payment Run

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>Client</th>

                                <th>Payment Period</th>

                                <th>Students</th>

                                <th>Eligible Days</th>

                                <th>Total Amount</th>

                                <th>Status</th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var run in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @run.Client?.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @run.PeriodFrom.ToString("MMMM yyyy")
                                    </td>

                                    <td>
                                        @run.TotalStudents
                                    </td>

                                    <td>
                                        @run.TotalEligibleDays
                                    </td>

                                    <td>
                                        <strong>
                                            @run.TotalAmount.ToString("C2", new System.Globalization.CultureInfo("en-ZA"))
                                        </strong>
                                    </td>

                                    <td>

                                        @if (run.Status == "Draft")
                                        {
                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>
                                        }
                                        else if (run.Status == "PendingReview")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending Review
                                            </span>
                                        }
                                        else if (run.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (run.Status == "Submitted")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Submitted
                                            </span>
                                        }
                                        else if (run.Status == "Processed")
                                        {
                                            <span class="badge bg-success">
                                                Processed
                                            </span>
                                        }
                                        else if (run.Status == "Failed")
                                        {
                                            <span class="badge bg-danger">
                                                Failed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @run.Status
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@run.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>