@model ClockItSystem.ViewModels.PaymentRunResultViewModel

@{
    ViewData["Title"] = "Payment Run Details";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <h2 class="mb-1 text-white">
                <i class="bi bi-cash-stack me-2"></i>
                Payment Run
            </h2>

            <p class="mb-0 text-white fw-semibold">
                @Model.ClientName
                <span class="mx-2">•</span>
                @Model.PeriodFrom.ToString("MMMM yyyy")
            </p>
        </div>
        <div class="d-flex gap-2">

            <a asp-action="Index"
              class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i>
                Payment Runs

            </a>

        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <!-- CLIENT -->
        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Client
                    </div>

                    <div class="fs-5 fw-semibold">
                        @Model.ClientName
                    </div>

                </div>

            </div>

        </div>


        <!-- PERIOD -->
        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Payment Period
                    </div>

                    <div class="fs-5 fw-semibold">
                        @Model.PeriodFrom.ToString("MMMM yyyy")
                    </div>

                </div>

            </div>

        </div>


        <!-- STUDENTS -->
        <div class="col-md-2">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Students
                    </div>

                    <div class="fs-4 fw-bold">
                        @Model.TotalStudents
                    </div>

                </div>

            </div>

        </div>


        <!-- ELIGIBLE DAYS -->
        <div class="col-md-2">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Eligible Days
                    </div>

                    <div class="fs-4 fw-bold">
                        @Model.TotalEligibleDays
                    </div>

                </div>

            </div>

        </div>


        <!-- TOTAL -->
        <div class="col-md-2">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Stipend
                    </div>

                    <div class="fs-5 fw-bold text-success">
                        @Model.TotalAmount.ToString("C2", new System.Globalization.CultureInfo("en-ZA"))
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- STATUS -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <strong>
                        Payment Run Status
                    </strong>

                </div>

                <div>

                    @if (Model.Status == "Draft")
                    {
                        <span class="badge bg-secondary fs-6">
                            Draft
                        </span>
                    }
                    else if (Model.Status == "PendingReview")
                    {
                        <span class="badge bg-warning text-dark fs-6">
                            Pending Review
                        </span>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <span class="badge bg-success fs-6">
                            Approved
                        </span>
                    }
                    else if (Model.Status == "Submitted")
                    {
                        <span class="badge bg-info text-dark fs-6">
                            Submitted
                        </span>
                    }
                    else if (Model.Status == "Processed")
                    {
                        <span class="badge bg-success fs-6">
                            Processed
                        </span>
                    }
                    else if (Model.Status == "Failed")
                    {
                        <span class="badge bg-danger fs-6">
                            Failed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">
                            @Model.Status
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- PAYMENT DETAILS -->
    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                <i class="bi bi-people me-2"></i>
                Student Payment Details
            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model.Students == null || !Model.Students.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-info-circle fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No payable students
                    </h5>

                    <p class="text-muted mb-0">
                        No students had eligible paid days during
                        this payment period.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Student
                                </th>

                                <th>
                                    Attendance
                                </th>

                                <th>
                                    Leave
                                </th>

                                <th>
                                    Sick Leave
                                </th>

                                <th>
                                    Family Leave
                                </th>

                                <th>
                                    Total Days
                                </th>

                                <th>
                                    Daily Rate
                                </th>

                                <th>
                                    Stipend
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var student in Model.Students)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-semibold">
                                            @student.StudentName
                                        </div>

                                        <small class="text-muted">
                                            @student.StudentNumber
                                        </small>

                                    </td>

                                    <td>
                                        @student.EligibleAttendanceDays
                                    </td>

                                    <td>
                                        @student.LeaveDays
                                    </td>

                                    <td>
                                        @student.SickLeaveDays
                                    </td>

                                    <td>
                                        @student.FamilyResponsibilityLeaveDays
                                    </td>

                                    <td>
                                        <strong>
                                            @student.TotalEligibleDays
                                        </strong>
                                    </td>

                                    <td>
                                        @student.DailyRate.ToString("C2", new System.Globalization.CultureInfo("en-ZA"))
                                    </td>

                                    <td>

                                        <strong class="text-success">
                                            @student.StipendAmount.ToString("C2", new System.Globalization.CultureInfo("en-ZA"))
                                        </strong>

                                    </td>

                                    <td>

                                        @if (student.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (student.Status == "Validated")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Validated
                                            </span>
                                        }
                                        else if (student.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (student.Status == "Submitted")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Submitted
                                            </span>
                                        }
                                        else if (student.Status == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else if (student.Status == "Failed")
                                        {
                                            <span class="badge bg-danger">
                                                Failed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @student.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- ACTIONS -->

    @if (Model.Students != null && Model.Students.Any())
    {
        <div class="d-flex justify-content-end gap-2 mt-4">

            <button type="button"
                   class="btn btn-primary"
                    disabled>

                <i class="bi bi-check-circle me-1"></i>
                Submit for Review

            </button>

        </div>
    }

</div>