@model ClockItSystem.ViewModels.PaymentRunResultViewModel

@{
    ViewData["Title"] = "Payment Run Details";
    var zar = new System.Globalization.CultureInfo("en-ZA");
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white"
                      style="width: 42px; height: 42px;">
                    <i class="bi bi-cash-stack fs-5"></i>
                </span>

                <div>
                    <h2 class="mb-0 text-white fw-bold">
                        Payment Run
                    </h2>

                    <div class="text-white fw-semibold">
                        @Model.ClientName
                        <span class="mx-2 opacity-75">•</span>
                        @Model.PeriodFrom.ToString("MMMM yyyy")
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index"
               class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i>
                Payment Runs
            </a>

            @if (Model.Status == "PendingReview" && User.IsInRole("Admin"))
            {
                <a asp-action="Review"
                   class="btn btn-outline-light">
                    <i class="bi bi-clipboard-check me-1"></i>
                    Payment Review
                </a>
            }
        </div>

    </div>


    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">
                                Client
                            </div>

                            <div class="fs-5 fw-bold mt-1">
                                @Model.ClientName
                            </div>
                        </div>

                        <i class="bi bi-building fs-4 text-primary"></i>
                    </div>

                </div>
            </div>
        </div>


        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">
                                Payment Period
                            </div>

                            <div class="fs-5 fw-bold mt-1">
                                @Model.PeriodFrom.ToString("MMMM yyyy")
                            </div>
                        </div>

                        <i class="bi bi-calendar3 fs-4 text-primary"></i>
                    </div>

                </div>
            </div>
        </div>


        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">
                                Students
                            </div>

                            <div class="fs-3 fw-bold mt-1">
                                @Model.TotalStudents
                            </div>
                        </div>

                        <i class="bi bi-people fs-4 text-primary"></i>
                    </div>

                </div>
            </div>
        </div>


        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">
                                Total Stipend
                            </div>

                            <div class="fs-4 fw-bold text-success mt-1">
                                @Model.TotalAmount.ToString("C2", zar)
                            </div>
                        </div>

                        <i class="bi bi-currency-exchange fs-4 text-success"></i>
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- STATUS & ELIGIBILITY SUMMARY -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row align-items-center g-3">

                <div class="col-lg-4">

                    <div class="text-muted small fw-semibold text-uppercase mb-1">
                        Payment Run Status
                    </div>

                    @if (Model.Status == "Draft")
                    {
                        <span class="badge bg-secondary px-3 py-2 fs-6">
                            <i class="bi bi-pencil-square me-1"></i>
                            Draft
                        </span>
                    }
                    else if (Model.Status == "PendingReview")
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                            <i class="bi bi-hourglass-split me-1"></i>
                            Pending Review
                        </span>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <span class="badge bg-success px-3 py-2 fs-6">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Approved
                        </span>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <span class="badge bg-danger px-3 py-2 fs-6">
                            <i class="bi bi-x-circle-fill me-1"></i>
                            Rejected
                        </span>
                    }
                    else if (Model.Status == "Submitted")
                    {
                        <span class="badge bg-info text-dark px-3 py-2 fs-6">
                            <i class="bi bi-send-fill me-1"></i>
                            Submitted
                        </span>
                    }
                    else if (Model.Status == "Processed")
                    {
                        <span class="badge bg-success px-3 py-2 fs-6">
                            <i class="bi bi-check2-all me-1"></i>
                            Processed
                        </span>
                    }
                    else if (Model.Status == "Failed")
                    {
                        <span class="badge bg-danger px-3 py-2 fs-6">
                            <i class="bi bi-exclamation-octagon-fill me-1"></i>
                            Failed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2 fs-6">
                            @Model.Status
                        </span>
                    }

                </div>


                <div class="col-lg-4">

                    <div class="text-muted small fw-semibold text-uppercase mb-1">
                        Eligible Days
                    </div>

                    <div class="fs-4 fw-bold">
                        @Model.TotalEligibleDays
                    </div>

                    <small class="text-muted">
                        Approved attendance and paid leave
                    </small>

                </div>


                <div class="col-lg-4">

                    <div class="text-muted small fw-semibold text-uppercase mb-1">
                        Amount to be Paid
                    </div>

                    <div class="fs-4 fw-bold text-success">
                        @Model.TotalAmount.ToString("C2", zar)
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PAYMENT DETAILS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">

                <div>
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-people me-2 text-primary"></i>
                        Student Payment Details
                    </h5>

                    <small class="text-muted">
                        Breakdown of eligible payment days and stipend amounts
                    </small>
                </div>

                @if (Model.Students != null && Model.Students.Any())
                {
                    <span class="badge bg-light text-dark border px-3 py-2">
                        @Model.Students.Count student(s)
                    </span>
                }

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Students == null || !Model.Students.Any())
            {
                <div class="text-center py-5 px-3">

                    <i class="bi bi-info-circle fs-1 text-muted"></i>

                    <h5 class="mt-3 fw-semibold">
                        No payable students
                    </h5>

                    <p class="text-muted mb-0">
                        No students had eligible paid days during this payment period.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-3">
                                    Student
                                </th>

                                <th class="text-center">
                                    Attendance
                                </th>

                                <th class="text-center">
                                    Leave
                                </th>

                                <th class="text-center">
                                    Sick Leave
                                </th>

                                <th class="text-center">
                                    Family Leave
                                </th>

                                <th class="text-center">
                                    Total Days
                                </th>

                                <th class="text-end">
                                    Daily Rate
                                </th>

                                <th class="text-end">
                                    Stipend
                                </th>

                                <th class="text-center pe-3">
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var student in Model.Students)
                            {
                                <tr>

                                    <td class="ps-3">

                                        <div class="fw-bold">
                                            @student.StudentName
                                        </div>

                                        <small class="text-muted">
                                            Student No. @student.StudentNumber
                                        </small>

                                    </td>


                                    <td class="text-center">
                                        @student.EligibleAttendanceDays
                                    </td>


                                    <td class="text-center">
                                        @student.LeaveDays
                                    </td>


                                    <td class="text-center">
                                        @student.SickLeaveDays
                                    </td>


                                    <td class="text-center">
                                        @student.FamilyResponsibilityLeaveDays
                                    </td>


                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            @student.TotalEligibleDays
                                        </span>
                                    </td>


                                    <td class="text-end">
                                        @student.DailyRate.ToString("C2", zar)
                                    </td>


                                    <td class="text-end">

                                        <strong class="text-success">
                                            @student.StipendAmount.ToString("C2", zar)
                                        </strong>

                                    </td>


                                    <td class="text-center pe-3">

                                        @if (student.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (student.Status == "Validated")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Validated
                                            </span>
                                        }
                                        else if (student.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (student.Status == "Submitted")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Submitted
                                            </span>
                                        }
                                        else if (student.Status == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else if (student.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else if (student.Status == "Failed")
                                        {
                                            <span class="badge bg-danger">
                                                Failed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @student.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- WORKFLOW ACTIONS -->
    @if (Model.Students != null && Model.Students.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                    <div>

                        <h6 class="mb-1 fw-bold">
                            <i class="bi bi-shield-check me-2"></i>
                            Payment Run Actions
                        </h6>

                        <small class="text-muted">
                            Actions available for the current payment run status.
                        </small>

                    </div>


                    <div class="d-flex flex-wrap justify-content-end gap-2">

                        @if (Model.Status == "Draft")
                        {
                            <form asp-action="SubmitForReview"
                                  asp-controller="PaymentRuns"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@Model.PaymentRunId" />

                                <button type="submit"
                                        class="btn btn-primary">

                                    <i class="bi bi-send me-1"></i>
                                    Submit for Review

                                </button>

                            </form>
                        }


                        @if (Model.Status == "PendingReview" && User.IsInRole("Admin"))
                        {
                            <button type="button"
                                    class="btn btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectPaymentRunModal">

                                <i class="bi bi-x-circle me-1"></i>
                                Reject

                            </button>


                            <form asp-action="ApprovePaymentRun"
                                  asp-controller="PaymentRuns"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@Model.PaymentRunId" />

                                <button type="submit"
                                        class="btn btn-success"
                                        onclick="return confirm('Are you sure you want to approve this payment run?');">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Approve Payment Run

                                </button>

                            </form>
                        }


                        @if (Model.Status == "Approved")
                        {
                            <div class="d-flex flex-wrap justify-content-end gap-2">

                                <a asp-action="NetcashPreview"
                                   asp-route-id="@Model.PaymentRunId"
                                   class="btn btn-primary">

                                    <i class="bi bi-bank me-1"></i>
                                    Prepare Netcash Batch

                                </a>

                                <span class="btn btn-success disabled">

                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Payment Run Approved

                                </span>

                            </div>
                        }

                        @if (Model.Status == "Rejected")
                        {
                            <span class="btn btn-danger disabled">
                                <i class="bi bi-x-circle-fill me-1"></i>
                                Payment Run Rejected
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- REJECTION MODAL -->
    @if (Model.Status == "PendingReview" && User.IsInRole("Admin"))
    {
        <div class="modal fade"
             id="rejectPaymentRunModal"
             tabindex="-1"
             aria-labelledby="rejectPaymentRunModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title fw-bold"
                            id="rejectPaymentRunModalLabel">

                            <i class="bi bi-x-circle text-danger me-2"></i>
                            Reject Payment Run

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>


                    <form asp-action="RejectPaymentRun"
                          asp-controller="PaymentRuns"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.PaymentRunId" />


                        <div class="modal-body">

                            <div class="alert alert-warning">

                                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                                This payment run will be marked as rejected
                                and cannot proceed to Netcash until it is
                                corrected and a new run is submitted for review.

                            </div>


                            <div class="mb-3">

                                <label for="rejectionReason"
                                       class="form-label fw-semibold">

                                    Reason for Rejection

                                </label>

                                <textarea id="rejectionReason"
                                          name="rejectionReason"
                                          class="form-control"
                                          rows="4"
                                          required
                                          maxlength="1000"
                                          placeholder="Enter the reason for rejecting this payment run..."></textarea>

                                <div class="form-text">
                                    Please provide a clear reason for audit purposes.
                                </div>

                            </div>

                        </div>


                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">

                                Cancel

                            </button>

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-x-circle me-1"></i>
                                Reject Payment Run

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    }

</div>
