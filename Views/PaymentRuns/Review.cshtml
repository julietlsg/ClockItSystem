@model ClockItSystem.ViewModels.PaymentReviewViewModel

@{
    ViewData["Title"] = "Payment Review";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <h2 class="mb-1 text-white">
                <i class="bi bi-clipboard-check me-2"></i>
                Payment Review
            </h2>

            <p class="mb-0 text-white fw-semibold">
                Review payment runs submitted for approval
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-primary">

                <i class="bi bi-arrow-left me-1"></i>
                Payment Runs

            </a>
        </div>

    </div>


    <!-- INFORMATION -->
    <div class="alert alert-info shadow-sm">

        <i class="bi bi-info-circle-fill me-2"></i>

        The payment runs below have been submitted for review.
        Review the payment details before approving a payment run.

    </div>


    <!-- PAYMENT RUNS -->
    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">

                <i class="bi bi-cash-stack me-2"></i>

                Pending Payment Runs

            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model.PaymentRuns == null ||
                 !Model.PaymentRuns.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-check-circle fs-1 text-success"></i>

                    <h5 class="mt-3">
                        No Payment Runs Pending Review
                    </h5>

                    <p class="text-muted mb-0">
                        There are currently no payment runs waiting for approval.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Client
                                </th>

                                <th>
                                    Payment Period
                                </th>

                                <th>
                                    Students
                                </th>

                                <th>
                                    Eligible Days
                                </th>

                                <th>
                                    Total Amount
                                </th>

                                <th>
                                    Created By
                                </th>

                                <th>
                                    Created
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var paymentRun in Model.PaymentRuns)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-semibold">
                                            @paymentRun.ClientName
                                        </div>

                                    </td>


                                    <td>

                                        @paymentRun.PeriodFrom.ToString("MMMM yyyy")

                                    </td>


                                    <td>

                                        @paymentRun.TotalStudents

                                    </td>


                                    <td>

                                        @paymentRun.TotalEligibleDays

                                    </td>


                                    <td>

                                        <strong class="text-success">

                                            @paymentRun.TotalAmount.ToString(
                                                "C2",
                                                new System.Globalization.CultureInfo("en-ZA"))

                                        </strong>

                                    </td>


                                    <td>

                                        @paymentRun.CreatedBy

                                    </td>


                                    <td>

                                        @paymentRun.CreatedAt.ToString("dd MMM yyyy HH:mm")

                                    </td>


                                    <td>

                                        <span class="badge bg-warning text-dark">

                                            Pending Review

                                        </span>

                                    </td>


                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@paymentRun.PaymentRunId"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            Review

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>