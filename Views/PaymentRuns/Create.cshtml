@model ClockItSystem.ViewModels.PaymentRunViewModel

@{
    ViewData["Title"] = "Create Payment Run";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-cash-stack me-2"></i>
                Create Payment Run
            </h2>

            <p class="mb-1 text-white">
                Generate a monthly stipend payment run for a client.
            </p>
        </div>

        <a asp-controller="PaymentRuns"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Payment Runs

        </a>

    </div>


    <!-- PAYMENT RUN FORM -->
    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                <i class="bi bi-calendar3 me-2"></i>
                Payment Period
            </h5>

        </div>


        <div class="card-body">

            <!-- VALIDATION SUMMARY -->

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>


            <form asp-action="Create"
                  asp-controller="PaymentRuns"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="row g-4">

                    <!-- CLIENT -->

                    <div class="col-md-6">

                        <label asp-for="ClientId"
                               class="form-label fw-semibold">

                            <i class="bi bi-building me-1"></i>
                            Client

                        </label>

                        <select asp-for="ClientId"
                                asp-items="Model.Clients"
                                class="form-select">

                            <option value="">
                                -- Select Client --
                            </option>

                        </select>

                        <span asp-validation-for="ClientId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PAYMENT PERIOD -->

                    <div class="col-md-6">

                        <label asp-for="PaymentPeriod"
                               class="form-label fw-semibold">

                            <i class="bi bi-calendar-month me-1"></i>
                            Payment Period

                        </label>

                        <input asp-for="PaymentPeriod"
                               type="month"
                               class="form-control" />

                        <span asp-validation-for="PaymentPeriod"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Select the month for which the stipend
                            payment run should be generated.
                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- PAYMENT CALCULATION INFORMATION -->

                <div class="alert alert-info">

                    <div class="d-flex">

                        <div class="me-3">

                            <i class="bi bi-info-circle-fill fs-4"></i>

                        </div>


                        <div>

                            <strong>
                                Payment calculation
                            </strong>

                            <p class="mb-0 mt-1">

                                The payment run will include:

                            </p>

                            <ul class="mb-0 mt-2">

                                <li>
                                    Approved attendance
                                </li>

                                <li>
                                    Approved leave
                                </li>

                                <li>
                                    Approved sick leave
                                </li>

                                <li>
                                    Approved family responsibility leave
                                </li>

                            </ul>

                            <p class="mb-0 mt-2">

                                Student absent, rejected and pending
                                attendance will not be paid.

                            </p>

                        </div>

                    </div>

                </div>


                <!-- ACTION BUTTONS -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="PaymentRuns"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-calculator me-1"></i>
                        Generate Payment Run

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}