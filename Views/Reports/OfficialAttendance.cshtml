@model IEnumerable<ClockItSystem.Models.ViewModels.AttendanceReportViewModel>

@{
    ViewData["Title"] = "Official Attendance Report";
    var selectedDate = (DateTime)ViewBag.SelectedDate;
}

<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Official Attendance Report</h2>

    <div class="d-flex gap-2">

            <form asp-action="OfficialAttendance"
                  method="get"
                  class="row g-2 align-items-end">

                <div class="col-md-3">

                    <label class="form-label">Client</label>

                    <select name="clientId"
                            class="form-select"
                            onchange="document.getElementById('reportFilterForm').submit();">

                        <option value="">All Clients</option>

                        @foreach (var client in Model.First().Clients)
                        {
                            <option value="@client.Value"
                                    selected="@(client.Value == ViewBag.ClientId?.ToString())">
                                @client.Text
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-3">

                    <label class="form-label">Site</label>

                    <select name="siteId" class="form-select">

                        <option value="">All Sites</option>

                        @foreach (var site in Model.FirstOrDefault()?.Sites ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@site.Value"
                                    selected="@(Context.Request.Query["siteId"] == site.Value)">
                                @site.Text
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label class="form-label">Attendance Date</label>

                    <input type="date"
                           name="date"
                           value="@selectedDate.ToString("yyyy-MM-dd")"
                           class="form-control" />

                </div>
            </form>
            <div class="col-md-6">

                <div class="d-flex gap-2">

                    <button class="btn btn-clockit flex-fill">
                        Generate Report
                    </button>

                    <button class="btn btn-success flex-fill"
                            formaction="@Url.Action("ExportPendingExcel")">
                        Export Excel
                    </button>

                    <button class="btn btn-danger flex-fill"
                            formaction="@Url.Action("ExportPendingPdf")">
                        Export PDF
                    </button>

                </div>

            </div>
        </div>
</div>
    <div class="clockit-card">
        @if (!Model.Any())
        {
            <div class="text-center p-4">
                <h5>No approved attendance records found for this date.</h5>
            </div>
        }
        else
        {
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Site</th>
                        <th>Student No.</th>
                        <th>Student</th>
                        <th>Programme/Course</th>
                        <th>Date</th>
                        <th>Clock Time</th>
                        <th>Method</th>
                        <th>Score</th>
                        <th>Approved By</th>
                        <th>Approved At</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
@*                             <td>
                                @if (!string.IsNullOrEmpty(item.CapturedImagePath))
                                {
                                    <img src="@item.CapturedImagePath"
                                         width="55"
                                         height="55"
                                         style="border-radius:50%; object-fit:cover;" />
                                }
                                else
                                {
                                    <span>No Image</span>
                                }
                            </td>
 *@
                            <td>@item.ClientName</td>
                            <td>@item.SiteName</td>
                            <td>@item.StudentNumber</td>
                            <td>@item.StudentName</td>
                            <td>@item.ProgrammeOrCourse</td>
                            <td>@item.AttendanceDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.ClockTime.ToString("HH:mm")</td>
                            <td>@item.VerificationMethod</td>
                            <td>@(item.VerificationScore?.ToString("0.00") ?? "-")%</td>
                            <td>@item.ApprovedBy</td>
                            <td>@(item.ApprovedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>