@model IEnumerable<ClockItSystem.Models.ViewModels.AttendanceReportViewModel>

@{
    ViewData["Title"] = "Pending Approvals Report";
    var selectedDate = (DateTime)ViewBag.SelectedDate;
}

<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Pending Approvals Report</h2>

    <div class="d-flex gap-2">

@*         <form asp-action="PendingApprovals" method="get" class="d-flex gap-2">
            <input type="date"
                   name="date"
                   value="@selectedDate.ToString("yyyy-MM-dd")"
                   class="form-control" />

            <button type="submit" class="btn btn-clockit">
                Filter
            </button>
        </form>
 *@
            <form asp-action="PendingApprovals"
                  method="get"
                  class="row g-2 align-items-end">

                <div class="col-md-3">

                    <label class="form-label">Client</label>

                    <select name="clientId" class="form-select">

                        <option value="">All Clients</option>

                        @foreach (var client in Model.FirstOrDefault()?.Clients ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@client.Value"
                                    selected="@(Context.Request.Query["clientId"] == client.Value)">
                                @client.Text
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label class="form-label">Site</label>

                    <select name="siteId" class="form-select">

                        <option value="">All Sites</option>

                        @foreach (var site in Model.FirstOrDefault()?.Sites ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@site.Value"
                                    selected="@(Context.Request.Query["siteId"] == site.Value)">
                                @site.Text
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label class="form-label">Attendance Date</label>

                    <input type="date"
                           name="date"
                           value="@selectedDate.ToString("yyyy-MM-dd")"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <button class="btn btn-clockit w-100">

                        Generate Report

                    </button>

                </div>

            </form>

            <a asp-action="ExportOfficialExcel"
                   asp-route-date="@selectedDate.ToString("yyyy-MM-dd")"
                   asp-route-clientId="@Context.Request.Query["clientId"]"
                   asp-route-siteId="@Context.Request.Query["siteId"]"
                   class="btn btn-success">

                Export Excel

            </a>
            <a asp-action="ExportOfficialPdf"
                   asp-route-date="@selectedDate.ToString("yyyy-MM-dd")"
                   asp-route-clientId="@Context.Request.Query["clientId"]"
                   asp-route-siteId="@Context.Request.Query["siteId"]"
                   class="btn btn-danger">

                Export PDF

            </a>

    </div>
</div>
    <div class="clockit-card">
        @if (!Model.Any())
        {
            <div class="text-center p-4">
                <h5>No pending attendance records found for this date.</h5>
            </div>
        }
        else
        {
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Site</th>
                        <th>Student No.</th>
                        <th>Student</th>
                        <th>Programme/Course</th>
                        <th>Date</th>
                        <th>Clock Time</th>
                        <th>Method</th>
                        <th>Score</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
@*                                 @if (!string.IsNullOrEmpty(item.CapturedImagePath))
                                {
                                    <img src="@item.CapturedImagePath"
                                         width="55"
                                         height="55"
                                         style="border-radius:50%; object-fit:cover;" />
                                }
                                else
                                {
                                    <span>No Image</span>
                                }
                            </td>
 *@
                            <td>@item.ClientName</td>
                            <td>@item.SiteName</td>
                            <td>@item.StudentNumber</td>
                            <td>@item.StudentName</td>
                            <td>@item.ProgrammeOrCourse</td>
                            <td>@item.AttendanceDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.ClockTime.ToString("HH:mm")</td>
                            <td>@item.VerificationMethod</td>
                            <td>@(item.VerificationScore?.ToString("0.00") ?? "-")%</td>
                            <td><span class="badge status-pending">Pending Approval</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>