<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Clock It</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/clockit-theme.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/administration.css" />

    <link rel="icon"
          type="image/png"
          href="~/favicon.png" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-clockit">

        <div class="container-fluid">

            <!-- Brand -->
            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-grid-1x2-fill me-1"></i>
                Clock It

            </a>

            <!-- Mobile menu button -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                    <!-- HOME -->
                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house-door-fill me-1"></i>
                            Home

                        </a>

                    </li>


                    <!-- ATTENDANCE VERIFICATION -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           id="attendanceDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            <i class="bi bi-person-check-fill me-1"></i>
                            Attendance Verification

                        </a>

                        <ul class="dropdown-menu dropdown-menu-dark"
                            aria-labelledby="attendanceDropdown">

                             @if (User.IsInRole("Assessor") || User.IsInRole("Admin"))
                            {
                               <li>
                                    <a class="dropdown-item"
                                       asp-controller="Approvals"
                                       asp-action="Daily">
                                        <i class="bi bi-check2-square me-2"></i>
                                        Attendance Approvals
                                    </a>
                              </li>
							}


                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Biometric"
                                   asp-action="Verify">

                                    <i class="bi bi-camera-fill me-2"></i>
                                    Facial Verification

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Biometric"
                                   asp-action="VerifyFingerprint">

                                    <i class="bi bi-fingerprint me-2"></i>
                                    Fingerprint Verification

                                </a>

                            </li>

                        </ul>

                    </li>


                    <!-- ADMINISTRATION -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           id="administrationDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            <i class="bi bi-gear-fill me-1"></i>
                            Administration

                        </a>

                        <ul class="dropdown-menu dropdown-menu-dark"
                            aria-labelledby="administrationDropdown">


                            <!-- Students -->
                            @if (User.IsInRole("Admin") ||
                                 User.IsInRole("Facilitator") ||
                                 User.IsInRole("Project Manager"))
                            {
                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Students"
                                       asp-action="Index">

                                        <i class="bi bi-people-fill me-2"></i>
                                        Students

                                    </a>

                                </li>
                            }


                            <!-- Clients -->
                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Client"
                                   asp-action="Index">

                                    <i class="bi bi-building me-2"></i>
                                    Clients

                                </a>

                            </li>


                            <!-- Sites -->
                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Site"
                                   asp-action="Index">

                                    <i class="bi bi-geo-alt-fill me-2"></i>
                                    Sites

                                </a>

                            </li>


                            <!-- Register User -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Account"
                                       asp-action="Register">

                                        <i class="bi bi-person-plus-fill me-2"></i>
                                        Register User

                                    </a>

                                </li>
                            }

                        </ul>

                    </li>


                    <!-- PAYMENTS -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           id="paymentsDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            <i class="bi bi-cash-stack me-1"></i>
                            Payments

                        </a>

                        <!-- DARK MENU -->
                        <ul class="dropdown-menu dropdown-menu-dark"
                            aria-labelledby="paymentsDropdown">


                            <!-- Stipend Rates -->
                            @if (User.IsInRole("Admin") || User.IsInRole("CEO"))
                            {
                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="StipendRates"
                                       asp-action="Index">

                                        <i class="bi bi-currency-exchange me-2"></i>
                                        Stipend Rates

                                    </a>

                                </li>
                            }


                            <!-- Payment Runs -->
                            <li>

                                <a class="dropdown-item"
                                   asp-controller="PaymentRuns"
                                   asp-action="Index">

                                    <i class="bi bi-calendar-check-fill me-2"></i>
                                    Payment Runs

                                </a>

                            </li>


                            <!-- Payment Review -->
                            <li>

                                <a class="dropdown-item"
                                   asp-controller="PaymentRuns"
                                   asp-action="Review">

                                    <i class="bi bi-clipboard-check-fill me-2"></i>
                                    Payment Review

                                </a>

                            </li>


                            <!-- Payment History -->
                            <li>

                                <a class="dropdown-item"
                                   asp-controller="PaymentRuns"
                                   asp-action="PaymentHistory">

                                    <i class="bi bi-clock-history me-2"></i>
                                    Payment History

                                </a>

                            </li>


                            <!-- Netcash -->
                            @if (User.IsInRole("Admin") || User.IsInRole("CEO"))
                            {
                                <li>

                                    <hr class="dropdown-divider" />

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Netcash"
                                       asp-action="Index">

                                        <i class="bi bi-bank2 me-2"></i>
                                        Netcash

                                    </a>

                                </li>
                            }

                        </ul>

                    </li>


                    <!-- REPORTS -->
                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("Project Manager") || 
                             User.IsInRole("CEO"))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   id="reportsDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-bar-chart-fill me-1"></i>
                                    Reports

                                </a>

                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end"
                                    aria-labelledby="reportsDropdown">


                                    <!-- Attendance Reports -->
                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Reports"
                                           asp-action="Index">

                                            <i class="bi bi-calendar-check me-2"></i>
                                            Attendance Reports

                                        </a>

                                    </li>


                                    <!-- Student Profile Report -->
                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Reports"
                                           asp-action="StudentProfile">

                                            <i class="bi bi-person-vcard me-2"></i>
                                            Student Profile Report

                                        </a>

                                    </li>

                                </ul>

                            </li>
                        }
                    }


                    <!-- LOGOUT -->
                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-link nav-link text-light">

                                    <i class="bi bi-box-arrow-right me-1"></i>
                                    Logout

                                </button>

                            </form>

                        </li>
                    }

                    }
                    else
                    {
                        <!-- LOGIN -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">

                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Login

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>


    <main role="main">

        @RenderBody()

    </main>


    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Tom Select -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">


    <!-- Live Search -->
    <script src="~/js/live-search.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>