@model ClockItSystem.Models.ViewModels.SearchFilterViewModel

<form id="searchForm"
      asp-action="@Model.Action"
      method="get"
      autocomplete="off"
      class="row g-3 mb-4">

    <div class="col-lg-8">

        <label class="form-label fw-semibold">

            Search

        </label>

        <input id="searchTerm"
               type="text"
               name="SearchTerm"
               value="@Model.Filter.SearchTerm"
               class="form-control"
               placeholder="Search..." />

    </div>

    @if (Model.ShowStatus)
    {
        <div class="col-lg-2">

            <label class="form-label fw-semibold">

                Status

            </label>

            <select id="statusFilter"
                    name="IsActive"
                    class="form-select">

                <option value=""
                        selected="@(Model.Filter.IsActive == null)">
                    All
                </option>

                <option value="true"
                        selected="@(Model.Filter.IsActive == true)">
                    Active
                </option>

                <option value="false"
                        selected="@(Model.Filter.IsActive == false)">
                    Inactive
                </option>

            </select>

        </div>
    }

    <div class="col-lg-2 d-flex align-items-end">

        <a asp-action="@Model.Action"
               class="btn btn-outline-secondary w-100">

            <i class="bi bi-arrow-clockwise me-1"></i>

            Clear

        </a>

    </div>

</form>