@model ClockItSystem.Models.ViewModels.SearchFilterViewModel

<form asp-action="@Model.Action"
      method="get"
      class="row g-3 mb-4">

    <div class="col-lg-5">

        <label class="form-label fw-semibold">

            Search

        </label>

        <input asp-for="Filter.SearchTerm"
               class="form-control"
               placeholder="Search..." />

    </div>

    @if (Model.ShowStatus)
    {
        <div class="col-lg-3">

            <label class="form-label fw-semibold">

                Status

            </label>

            <select asp-for="Filter.IsActive"
                    class="form-select">

                <option value="">All</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>

            </select>

        </div>
    }

    <div class="col-lg-2 d-flex align-items-end">

        <button class="btn btn-primary w-100">

            <i class="bi bi-search"></i>

            Search

        </button>

    </div>

    <div class="col-lg-2 d-flex align-items-end">

        <a asp-action="@Model.Action"
               class="btn btn-secondary w-100">

            <i class="bi bi-arrow-clockwise"></i>

            Clear

        </a>

    </div>

</form>